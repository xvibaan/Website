{
    "name": "host-market-place-backend",
    "version": "0.1.0",
    "private": true,
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate --config=./drizzle.config.ts",
        "db:migrate": "drizzle-kit migrate --config=./drizzle.config.ts",
        "db:migrate:prod": "tsx src/scripts/migrate.ts",
        "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
        "seed:categories": "tsx src/scripts/seed-categories.ts",
        "test": "echo \"Automated backend tests are currently not implemented.\" && exit 1"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1141.0",
        "@fastify/cookie": "^11.1.3",
        "@fastify/cors": "^11.3.1",
        "@fastify/multipart": "^10.1.3",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/sensible": "^6.0.7",
        "@fastify/static": "^10.1.5",
        "bcryptjs": "^3.0.3",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.45.3",
        "fastify": "^5.12.5",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "razorpay": "^2.9.8",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.12.7",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.7.2",
        "typescript": "^5.4.5"
    }
}
