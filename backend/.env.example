# Application Settings
PROJECT_NAME="Digital Marketplace API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:3000"

# Security
# Replace with a strong, securely generated cryptographic key
SECRET_KEY="your_super_secret_key_placeholder_here"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Replace with your actual database connection string
DATABASE_URL="postgresql+asyncpg://db_user:db_password@localhost:5432/marketplace_db"

# Financial & Payment Configuration
# System-wide primary currency. Must be a valid 3-letter ISO 4217 code.
PAYMENT_CURRENCY="INR"

# Webhook Secrets Registry
# A JSON-encoded dictionary mapping provider names to their respective webhook signature secrets.
# Ensure the value is valid JSON. Single quotes around the JSON string are recommended.
PAYMENT_WEBHOOK_SECRETS='{"stripe": "whsec_example_placeholder", "razorpay": "rzp_webhook_secret_example"}'
