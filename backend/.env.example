PROJECT_NAME="Digital Marketplace API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
# Secrets are kept server-side only
SECRET_KEY="replace-this-with-a-very-strong-secret-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/marketplace"
# Define specific frontend origin for strict CORS in production
FRONTEND_URL="http://localhost:3000"
