# ==============================================================================
# Master Backend Environment Configuration (Template / Placeholders Only)
# ==============================================================================

# ------------------------------------------------------------------------------
# PUBLIC / NETWORK
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
# Update to production domains, e.g., https://customer.example.com,https://admin.example.com
CORS_ORIGINS=https://customer.example.com,https://admin.example.com

# ------------------------------------------------------------------------------
# DATABASE SECRET
# ------------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ------------------------------------------------------------------------------
# SERVER SECRET
# ------------------------------------------------------------------------------
AUTH_SECRET=replace-with-secure-secret-placeholder
AUTH_COOKIE_NAME=host_market_session
AUTH_SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# PAYMENT SECRET
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_DEFAULT=razorpay
PAYMENT_TIMEOUT_MS=10000

# Razorpay Keys
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# ------------------------------------------------------------------------------
# PROVIDER SECRET
# ------------------------------------------------------------------------------
PROVIDER_REQUEST_TIMEOUT_MS=10000
PROVIDER_MAX_RETRIES=2
# Real provider secrets are generally managed in the DB or as specific ENV vars here.

# ------------------------------------------------------------------------------
# STORAGE SECRET
# ------------------------------------------------------------------------------
# Use 's3' for production object storage
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=hostmarket-product-images
STORAGE_ACCESS_KEY_ID=replace-with-access-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-secret-access-key
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
